<%- include('../shared/layout-start') %>
<%- include('../shared/auth') %>
<div class="container col-xxl-8 px-4 py-5">
  <div class="row flex-lg-row-reverse align-items-center g-5 py-5">
    <div class="col-10 col-sm-8 col-lg-6">
      <img
        src="/<%= book.fileCover %>"
        class="d-block mx-lg-auto img-fluid"
        alt="Bootstrap Themes"
        width="700"
        height="500"
        loading="lazy"
      />
    </div>
    <div class="col-lg-6">
      <h1 class="display-5 fw-bold text-body-emphasis lh-1 mb-3"><%= book.title %></h1>
      <p class="lead"><%= book.description %></p>
      <p class="lead">Авторы: <%= book.authors %></p>
      <p class="lead">Просмотры: <%= counter %></p>
    </div>
  </div>

  <div id="comments"></div>

  <div class="mb-3">
    <input
      id="username"
      name="username"
      class="form-control"
      placeholder="username">
  </div>
  <div class="mb-3">
    <label class="form-label">Комментарий</label>
    <textarea
      id="text"
      name="text"
      class="form-control"
      rows="3"
    ></textarea>
  </div>
  <button id="send" type="submit" class="btn btn-primary">Отправить</button>
</div>
<%- include('../shared/layout-end') %>
